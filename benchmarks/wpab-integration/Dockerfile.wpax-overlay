# Harbor environment overlay for WPAX Conditions B and C on top of apeatling/wp-agent-benchmark.
#
# Build from the root of the wp-agent-experience repository:
#   docker build -t wpab-wpax-cond-c:latest \
#     --build-arg BASE_IMAGE=wpab-dev-machine:latest \
#     --build-arg WPAX_CONDITION=C \
#     -f benchmarks/wpab-integration/Dockerfile.wpax-overlay .

ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

ARG WPAX_CONDITION=C
ENV WPAX_CONDITION=${WPAX_CONDITION}
ENV WPAX_HOME=/opt/wpax

# Copy only public, credential-free WPAX artifacts into /opt/wpax
WORKDIR /opt/wpax
COPY skills/wp-platform-selection /opt/wpax/skills/wp-platform-selection
COPY registry/wp-capabilities.json /opt/wpax/registry/wp-capabilities.json
COPY registry/schema/wp-capabilities.schema.json /opt/wpax/registry/schema/wp-capabilities.schema.json
COPY blueprints /opt/wpax/blueprints
COPY benchmarks/wpab-integration/setup-wpax-env.sh /opt/wpax/setup-wpax-env.sh

RUN chmod +x /opt/wpax/setup-wpax-env.sh \
    && /opt/wpax/setup-wpax-env.sh --condition "${WPAX_CONDITION}" --wpax-home /opt/wpax

WORKDIR /app
