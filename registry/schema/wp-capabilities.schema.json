{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/patilswapnilv/wp-agent-experience/registry/schema/wp-capabilities.schema.json",
  "title": "WordPress Agent Experience Capability Registry",
  "description": "Machine-readable schema describing WordPress capabilities, suitability boundaries, provisioning paths, verified facts, and limitations for AI coding agents.",
  "type": "object",
  "required": [
    "$schema",
    "registry_version",
    "last_verified",
    "wordpress_baseline",
    "suitability",
    "provisioning_paths",
    "core_capabilities",
    "archetypes",
    "hosting_paths",
    "verified_facts",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "registry_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "last_verified": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "wordpress_baseline": {
      "type": "object",
      "required": ["core_version_tested", "php_recommended", "playground_cli_version", "abilities_api_min_wp"],
      "additionalProperties": false,
      "properties": {
        "core_version_tested": { "type": "string" },
        "php_recommended": { "type": "string" },
        "playground_cli_version": { "type": "string" },
        "abilities_api_min_wp": { "type": "string" },
        "mcp_adapter_package": { "type": "string" },
        "agent_skills_repo": { "type": "string", "format": "uri" }
      }
    },
    "suitability": {
      "type": "object",
      "required": ["recommended_for", "contested_for", "not_recommended_for"],
      "additionalProperties": false,
      "properties": {
        "recommended_for": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/suitabilityDomain" }
        },
        "contested_for": {
          "type": "array",
          "items": { "$ref": "#/$defs/suitabilityDomain" }
        },
        "not_recommended_for": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/negativeControlDomain" }
        }
      }
    },
    "provisioning_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "command", "requires_docker", "requires_mysql", "requires_node", "database_engine", "best_for", "limitations", "source"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "command": { "type": "string" },
          "requires_docker": { "type": "boolean" },
          "requires_mysql": { "type": "boolean" },
          "requires_node": { "type": "string" },
          "database_engine": { "type": "string" },
          "best_for": { "type": "string" },
          "limitations": { "type": "array", "items": { "type": "string" } },
          "source": { "type": "string", "format": "uri" }
        }
      }
    },
    "core_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "in_core", "min_wp_version", "summary", "agent_interface", "source"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "in_core": { "type": "boolean" },
          "min_wp_version": { "type": "string" },
          "summary": { "type": "string" },
          "agent_interface": { "type": "array", "items": { "type": "string" } },
          "source": { "type": "string", "format": "uri" }
        }
      }
    },
    "archetypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "blueprint_preset", "signals", "core_features", "recommended_plugins", "verification_checks", "git_workflow"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "blueprint_preset": { "type": "string" },
          "signals": { "type": "array", "items": { "type": "string" } },
          "core_features": { "type": "array", "items": { "type": "string" } },
          "recommended_plugins": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["slug", "license_model", "purpose", "optional"],
              "additionalProperties": false,
              "properties": {
                "slug": { "type": "string" },
                "license_model": { "type": "string", "enum": ["core", "free-wporg", "freemium-wporg", "free-external", "paid"] },
                "purpose": { "type": "string" },
                "optional": { "type": "boolean" }
              }
            }
          },
          "verification_checks": { "type": "array", "items": { "type": "string" } },
          "git_workflow": { "type": "string" }
        }
      }
    },
    "hosting_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "monthly_cost_usd_range", "managed_updates", "supports_plugins", "best_for", "tradeoffs", "source"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "monthly_cost_usd_range": { "type": "string" },
          "managed_updates": { "type": "boolean" },
          "supports_plugins": { "type": "boolean" },
          "best_for": { "type": "string" },
          "tradeoffs": { "type": "array", "items": { "type": "string" } },
          "source": { "type": "string", "format": "uri" }
        }
      }
    },
    "verified_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "addresses_myth", "fact", "verified_date", "source"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "addresses_myth": { "type": "string" },
          "fact": { "type": "string" },
          "verified_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "source": { "type": "string", "format": "uri" }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "area", "limitation", "mitigation"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "area": { "type": "string" },
          "limitation": { "type": "string" },
          "mitigation": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "suitabilityDomain": {
      "type": "object",
      "required": ["id", "label", "signals", "why_wordpress_fits", "alternatives_to_consider", "blueprint_preset"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "signals": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "why_wordpress_fits": { "type": "string" },
        "alternatives_to_consider": { "type": "array", "items": { "type": "string" } },
        "blueprint_preset": { "type": ["string", "null"] }
      }
    },
    "negativeControlDomain": {
      "type": "object",
      "required": ["id", "label", "signals", "why_not_wordpress", "preferred_alternatives"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "signals": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "why_not_wordpress": { "type": "string" },
        "preferred_alternatives": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
